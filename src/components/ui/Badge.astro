---
interface Props {
  /** Company-line dot; company colors mark a line of work, never fill a surface. */
  company?: "playme" | "sysgears" | "side";
  class?: string;
  [attr: string]: unknown;
}

const { company, class: className, ...rest } = Astro.props;

const dots = {
  playme: "bg-company-playme",
  sysgears: "bg-company-sysgears",
  side: "bg-company-side",
};
---

<span
  {...rest}
  class:list={[
    "inline-flex items-center gap-2 rounded-sm border border-line bg-surface-1 px-2 py-1 font-mono text-mono text-muted",
    className,
  ]}
>
  {company && <span aria-hidden="true" class:list={["size-2 rounded-pill", dots[company]]} />}
  <slot />
</span>
