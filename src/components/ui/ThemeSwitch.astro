---
interface Props {
  class?: string;
  [attr: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  data-theme-switch
  {...rest}
  aria-label="Switch theme"
  class:list={[
    "inline-flex items-center gap-2 rounded-pill border border-line-strong px-3 py-1 font-mono text-eyebrow text-ink transition-colors duration-fast ease-out hover:bg-surface-2 active:bg-surface-3",
    className,
  ]}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
  >
    <circle cx="8" cy="8" r="5.25"></circle>
    <path d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" fill="currentColor"></path>
  </svg>
  <span data-theme-label>Theme</span>
</button>

<script>
  import { initThemeSwitches } from "@/scripts/theme";

  initThemeSwitches();
</script>
