---
import RuleList from "@/components/blocks/RuleList.astro";
import SectionHeading from "@/components/blocks/SectionHeading.astro";
import type { Rules } from "@/lib/types";

interface Props {
  rules: Rules;
}

const { rules } = Astro.props;
---

<section data-reveal aria-labelledby="rules" class="flex flex-col gap-5">
  <SectionHeading id="rules" title="Project rules and agent setup" />
  <RuleList items={rules.items} />
  {rules.agents && (
    <div class="flex flex-col gap-2 border-t border-line pt-5">
      <h3 class="text-h3">Agent setup</h3>
      <p class="max-w-prose text-muted">{rules.agents}</p>
    </div>
  )}
</section>
