---
import Chip from "@/components/ui/Chip.astro";
import { aiAgentsLabel, disciplineLabels } from "@/lib/projects";
import { projectFilterKeys } from "@/lib/filters";
import { projectPath } from "@/lib/site";
import type { Project } from "@/lib/types";

interface Props {
  project: Project;
  [attr: string]: unknown;
}

const { project, ...rest } = Astro.props;
---

<li
  {...rest}
  data-project
  data-filter-keys={projectFilterKeys(project).join(" ")}
  class="project-row relative flex flex-col gap-2 rounded-md border border-line bg-surface-1 p-4 sm:p-5"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-h3">
      <a
        href={projectPath(project.slug)}
        class="project-link text-ink no-underline"
        style={`view-transition-name: project-${project.slug}`}
      >
        {project.title}
      </a>
    </h3>
    <p class="font-mono text-mono text-muted">{project.period}</p>
  </div>
  <p class="max-w-prose text-small text-muted">{project.summary}</p>
  <p class="text-small text-muted">{project.role}</p>
  <ul class="mt-1 flex flex-wrap gap-2" aria-label="Disciplines">
    {project.disciplines.map((discipline) => (
      <li>
        <Chip variant="discipline">{disciplineLabels[discipline]}</Chip>
      </li>
    ))}
    {project.aiAgents && (
      <li>
        <Chip variant="ai">{aiAgentsLabel}</Chip>
      </li>
    )}
  </ul>
</li>

<style>
  /* Hover or keyboard focus lights the row's border: a ring from --signal to --signal-2 lies over the
     hairline, its bright point runs once around the row (--dur-trace) and it stays lit with a soft glow.
     The mask keeps only the 1px border box of the ring. */
  .project-row {
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  .project-row::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 1px solid transparent;
    border-radius: inherit;
    background: conic-gradient(
        from var(--trace-angle),
        var(--signal-glow),
        var(--signal-2) 18%,
        var(--line-strong) 40% 60%,
        var(--signal-2) 82%,
        var(--signal-glow)
      )
      border-box;
    mask:
      linear-gradient(var(--ink), var(--ink)) padding-box,
      linear-gradient(var(--ink), var(--ink)) border-box;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .project-row:has(.project-link:focus-visible) {
    box-shadow: var(--glow-row);
  }

  .project-row:has(.project-link:focus-visible)::before {
    opacity: 1;
    animation: trace-run var(--dur-trace) var(--ease-move);
  }

  /* Only where hover is real: on touch a tap would leave the ring on after the page comes back. */
  @media (hover: hover) {
    .project-row:hover {
      box-shadow: var(--glow-row);
    }

    .project-row:hover::before {
      opacity: 1;
      animation: trace-run var(--dur-trace) var(--ease-move);
    }
  }

  /* The whole row is the link: the anchor's box stretches over it, so chips and text need no extra links. */
  .project-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .project-link:focus-visible {
    outline: none;
  }

  .project-link:focus-visible::after {
    outline: var(--ring-width) solid var(--signal);
    outline-offset: var(--ring-offset);
  }
</style>
