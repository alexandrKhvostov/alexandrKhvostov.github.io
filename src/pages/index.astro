---
import ProjectList from "@/components/sections/ProjectList.astro";
import { loadProjects } from "@/content/load";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homeDescription, homeLead, homeTitle } from "@/lib/site";

const projects = await loadProjects();
---

<BaseLayout title={homeTitle} description={homeDescription}>
  <div class="flex flex-col gap-7 pt-7 pb-section">
    <div class="flex flex-col gap-4">
      <h1 data-enter style="--i: 0" class="text-display">
        Projects
      </h1>
      <p data-enter style="--i: 1" class="max-w-prose text-lead text-muted">
        {homeLead}
      </p>
    </div>
    <ProjectList projects={projects} />
  </div>
</BaseLayout>
