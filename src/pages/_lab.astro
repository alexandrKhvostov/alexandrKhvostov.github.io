---
import CodeBlock from "@/components/blocks/CodeBlock.astro";
import DecisionLog from "@/components/blocks/DecisionLog.astro";
import ContactLinks from "@/components/blocks/ContactLinks.astro";
import DiagramSteps from "@/components/blocks/DiagramSteps.astro";
import Fold from "@/components/blocks/Fold.astro";
import GlanceStrip from "@/components/blocks/GlanceStrip.astro";
import PipelineDiagram from "@/components/blocks/PipelineDiagram.astro";
import ProjectRow from "@/components/blocks/ProjectRow.astro";
import ShowcaseStrip from "@/components/blocks/ShowcaseStrip.astro";
import RuleList from "@/components/blocks/RuleList.astro";
import ToolList from "@/components/blocks/ToolList.astro";
import ScreenFrame from "@/components/blocks/ScreenFrame.astro";
import SectionHeading from "@/components/blocks/SectionHeading.astro";
import SequenceDiagram from "@/components/blocks/SequenceDiagram.astro";
import ProjectArchitecture from "@/components/sections/ProjectArchitecture.astro";
import ProjectConnections from "@/components/sections/ProjectConnections.astro";
import ProjectDecisions from "@/components/sections/ProjectDecisions.astro";
import ProjectHeader from "@/components/sections/ProjectHeader.astro";
import ProjectList from "@/components/sections/ProjectList.astro";
import ProjectOverview from "@/components/sections/ProjectOverview.astro";
import ProjectRules from "@/components/sections/ProjectRules.astro";
import ProjectShowcase from "@/components/sections/ProjectShowcase.astro";
import ProjectStructure from "@/components/sections/ProjectStructure.astro";
import ProjectTools from "@/components/sections/ProjectTools.astro";
import Badge from "@/components/ui/Badge.astro";
import Chip from "@/components/ui/Chip.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import ThemeSwitch from "@/components/ui/ThemeSwitch.astro";
import placeholder1 from "@/assets/lab/placeholder-1.png";
import placeholder2 from "@/assets/lab/placeholder-2.png";
import placeholder3 from "@/assets/lab/placeholder-3.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { incomingConnections, outgoingConnections } from "@/lib/connections";
import {
  decisionsFixture,
  fixtureProjects,
  pipelineFixture,
  rulesFixture,
  sequenceFixture,
  showcaseFixture,
  structureFixture,
  toolsFixture,
} from "@/lib/fixtures";
import {
  colorRoles,
  fontRoles,
  glowRoles,
  motionRoles,
  otherThemeRoles,
  radiusRoles,
  spaceRoles,
  typeRoles,
} from "@/styles/roles";
import { themes } from "@/styles/themes/index";

// Served at /lab by the lab-dev-only integration in astro.config.mjs. The leading underscore keeps
// Astro's file router from building it, so `astro build` ships neither the page nor its script.

const groups = ["canvas", "line", "text", "signal", "code", "company", "kind"] as const;
const variants = ["primary", "secondary", "quiet"] as const;
const states = [
  { id: "default", demo: undefined, disabled: false },
  { id: "hover", demo: "hover", disabled: false },
  { id: "focus", demo: "focus", disabled: false },
  { id: "disabled", demo: undefined, disabled: true },
] as const;
const companies = ["playme", "sysgears", "side"] as const;
const chipStates = [
  { id: "default", pressed: false, demo: undefined },
  { id: "hover", pressed: false, demo: "hover" },
  { id: "focus", pressed: false, demo: "focus" },
  { id: "pressed", pressed: true, demo: undefined },
] as const;
const placeholders = [placeholder1, placeholder2, placeholder3];
const showcase = {
  ...showcaseFixture,
  screens: showcaseFixture.screens.map((screen, index) =>
    Object.assign({ image: placeholders[index]! }, screen),
  ),
};
const sampleProject = fixtureProjects[0]!;
const outgoing = outgoingConnections(sampleProject.slug, fixtureProjects);
const incoming = incomingConnections(sampleProject.slug, fixtureProjects);
const entranceBlocks = ["Header", "Lead", "Diagram", "Rules"] as const;
---

<BaseLayout title="Lab" noindex>
  <div class="flex flex-col gap-section py-7">
    <header class="flex flex-col gap-3">
      <p class="font-mono text-mono text-muted">Dev only, not built, not linked</p>
      <h1 class="text-h1">Lab</h1>
      <p class="max-w-prose text-muted">
        Every token and component in every state. Change a color with the pickers, copy the result as CSS,
        paste it into the theme file.
      </p>
    </header>

    <section class="flex flex-col gap-4" aria-labelledby="lab-themes">
      <h2 id="lab-themes" class="text-h2">
        Theme
      </h2>
      <div class="flex flex-wrap items-center gap-3">
        <ThemeSwitch />
        {themes.map((theme) => (
          <Button variant="secondary" data-lab-theme={theme.id}>
            {theme.label}
          </Button>
        ))}
      </div>
      <p class="text-small text-muted">
        Switching a theme clears the live edits below. Roles a theme also sets: {otherThemeRoles.join(", ")}.
      </p>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-colors">
      <h2 id="lab-colors" class="text-h2">
        Color roles
      </h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="primary" data-lab-copy>
          Copy as CSS
        </Button>
        <Button variant="secondary" data-lab-reset>
          Reset edits
        </Button>
        <span class="text-small text-muted" data-lab-status role="status"></span>
      </div>
      <pre
        class="overflow-x-auto rounded-md bg-code-bg p-4 font-mono text-small text-code-ink"
        data-lab-output
      >No edits yet.</pre>
      {groups.map((group) => (
        <div class="flex flex-col gap-3">
          <h3 class="font-mono text-mono text-muted">{group}</h3>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {colorRoles
              .filter((role) => role.group === group)
              .map((role) => (
                <li
                  class="flex items-center gap-3 rounded-md border border-line bg-surface-1 p-3"
                  data-lab-role={role.name}
                >
                  <span class:list={["size-7 shrink-0 rounded-sm border border-line-strong", role.swatch]} />
                  <span class="flex min-w-0 flex-1 flex-col">
                    <code class="truncate">--{role.name}</code>
                    <span class="truncate text-small text-muted">{role.use}</span>
                    <span class="truncate font-mono text-mono text-muted" data-lab-value />
                  </span>
                  <input
                    type="color"
                    aria-label={`Edit --${role.name}`}
                    class="h-5 w-7 shrink-0 rounded-sm border border-line-strong bg-transparent p-0"
                    data-lab-input
                  />
                </li>
              ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-type">
      <h2 id="lab-type" class="text-h2">
        Type
      </h2>
      <ul class="flex flex-col gap-4">
        {typeRoles.map((role) => (
          <li class="flex flex-col gap-1 border-b border-line pb-4">
            <code class="text-small text-muted">
              --text-{role.name} · {role.use}
            </code>
            <p class={role.cls}>The map is computed from the data</p>
          </li>
        ))}
      </ul>
      <ul class="flex flex-col gap-3">
        {fontRoles.map((role) => (
          <li class="flex flex-col gap-1">
            <code class="text-small text-muted">
              --font-{role.name} · {role.use}
            </code>
            <p class:list={[role.cls, "text-h3"]}>Architecture notes 0123456789</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-shape">
      <h2 id="lab-shape" class="text-h2">
        Radius, space, motion
      </h2>
      <ul class="flex flex-wrap gap-4">
        {radiusRoles.map((role) => (
          <li class="flex flex-col gap-2">
            <span class:list={["block h-7 w-8 border border-line-strong bg-surface-2", role.cls]} />
            <code class="text-small text-muted">--radius-{role.name}</code>
          </li>
        ))}
      </ul>
      <ul class="flex flex-col gap-2">
        {spaceRoles.map((role) => (
          <li class="flex items-center gap-3">
            <code class="w-9 shrink-0 text-small text-muted">--space-{role.step}</code>
            <span class:list={["block h-3 rounded-sm bg-signal", role.cls]} />
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-4">
        {motionRoles.map((role) => (
          <div class="flex flex-col gap-2">
            <button
              type="button"
              class:list={[
                "rounded-sm border border-line-strong px-3 py-2 text-small transition-transform ease-out hover:translate-x-5",
                role.cls,
              ]}
            >
              hover me
            </button>
            <code class="text-small text-muted">--dur-{role.name}</code>
          </div>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-glow">
      <h2 id="lab-glow" class="text-h2">
        Glow
      </h2>
      <p class="max-w-prose text-small text-muted">
        Glow belongs to diagrams and screens, never to text or whole cards. Strength follows the theme: full
        in dark, about a third in light.
      </p>

      <ul class="flex flex-wrap gap-5">
        {glowRoles.map((role) => (
          <li class="flex flex-col gap-3">
            <span class:list={["block h-8 w-9 rounded-md border border-line bg-surface-2", role.cls]} />
            <code class="text-small text-muted">
              --glow-{role.name} · {role.use}
            </code>
          </li>
        ))}
      </ul>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Ambient glow</h3>
        <div class="ambient-stage" aria-hidden="true">
          <span class="ambient-glow" data-ambient></span>
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-entrance">
      <h2 id="lab-entrance" class="text-h2">
        Entrance
      </h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="secondary" data-lab-replay>
          Replay entrance
        </Button>
        <span class="text-small text-muted">
          Blocks fade and rise in sequence, <code>--stagger</code> apart.
        </span>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-lab-entrance>
        {entranceBlocks.map((block, index) => (
          <li
            data-enter
            style={`--i: ${index}`}
            class="rounded-md border border-line bg-surface-1 p-4 text-small"
          >
            {block}
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-components">
      <h2 id="lab-components" class="text-h2">
        Components
      </h2>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Button</h3>
        {variants.map((variant) => (
          <div class="flex flex-wrap items-center gap-3">
            <code class="w-9 shrink-0 text-small text-muted">{variant}</code>
            {states.map((state) => (
              <Button variant={variant} disabled={state.disabled} data-demo-state={state.demo}>
                {state.id}
              </Button>
            ))}
            <Button variant={variant} href="#lab-components">
              as link
            </Button>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Badge</h3>
        <div class="flex flex-wrap items-center gap-3">
          <Badge>Astro</Badge>
          <Badge>TypeScript</Badge>
          {companies.map((company) => (
            <Badge company={company}>{company}</Badge>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Link</h3>
        <p class="flex flex-wrap items-center gap-4">
          <Link href="#lab-components">default</Link>
          <Link href="#lab-components" data-demo-state="hover">
            hover
          </Link>
          <Link href="#lab-components" data-demo-state="focus">
            focus
          </Link>
          <Link href="https://astro.build" external>
            external
          </Link>
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Theme switch</h3>
        <div class="flex flex-wrap items-center gap-3">
          <ThemeSwitch />
          <ThemeSwitch data-demo-state="hover" />
          <ThemeSwitch data-demo-state="focus" />
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-5" aria-labelledby="lab-blocks">
      <h2 id="lab-blocks" class="text-h2">
        Project blocks
      </h2>
      <p class="max-w-prose text-small text-muted">
        Built from invented data in <code>src/lib/fixtures.ts</code>. Nothing here describes a real project.
      </p>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Chip</h3>
        <div class="flex flex-wrap items-center gap-3">
          <code class="w-9 shrink-0 text-small text-muted">stack</code>
          <Chip variant="stack">TypeScript</Chip>
          <Chip variant="stack">PostgreSQL</Chip>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <code class="w-9 shrink-0 text-small text-muted">discipline</code>
          <Chip variant="discipline">Backend</Chip>
          <Chip variant="discipline">Full stack</Chip>
          <code class="w-9 shrink-0 text-small text-muted">ai</code>
          <Chip variant="ai">AI agents</Chip>
          <code class="w-9 shrink-0 text-small text-muted">held</code>
          <Chip variant="held">CI check</Chip>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <code class="w-9 shrink-0 text-small text-muted">filter</code>
          {chipStates.map((state) => (
            <Chip variant="filter" pressed={state.pressed} data-demo-state={state.demo}>
              {state.id}
            </Chip>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Project row</h3>
        <p class="max-w-prose text-small text-muted">
          A 4px left edge in the company color; hover lifts the border to <code>--signal-2</code> with a soft
          glow. The whole row is one link. Left to right: rest, hover.
        </p>
        <ul class="grid grid-cols-1 gap-3 lg:grid-cols-2">
          <ProjectRow project={fixtureProjects[0]!} />
          <ProjectRow project={fixtureProjects[2]!} data-demo-state="hover" />
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Glance strip</h3>
        <GlanceStrip items={sampleProject.glance} />
        <GlanceStrip
          items={[
            { value: "9", label: "endpoints" },
            { value: "4", label: "tables" },
            { value: "1 h", label: "token lifetime" },
            { value: "30 days", label: "refresh lifetime" },
          ]}
        />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Section heading</h3>
        <SectionHeading id="lab-demo-heading" title="Section title" />
        <p class="text-small text-muted">
          The # shows on hover and focus, always on touch screens; click copies the link.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Screen frame</h3>
        <ScreenFrame caption="Caption under the picture.">
          <p class="text-small text-muted">Any picture or diagram goes inside.</p>
        </ScreenFrame>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Pipeline diagram (step 3 active, one retry, one skip, one self step)</h3>
        <div data-diagram class="flex flex-col gap-5">
          <ScreenFrame caption={pipelineFixture.caption} signal>
            <PipelineDiagram diagram={pipelineFixture} activeStep={2} />
          </ScreenFrame>
          <DiagramSteps
            steps={pipelineFixture.steps}
            nodes={pipelineFixture.nodes}
            activeStep={2}
            idPrefix="lab-pipe"
          />
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">
          Phone drawings (a 22rem column: sequence without message text, vertical pipeline)
        </h3>
        <div class="lab-narrow flex flex-col gap-5">
          <div data-diagram class="flex flex-col gap-5">
            <ScreenFrame caption={sequenceFixture.caption} signal>
              <SequenceDiagram diagram={sequenceFixture} activeStep={1} />
            </ScreenFrame>
            <DiagramSteps
              steps={sequenceFixture.steps}
              nodes={sequenceFixture.nodes}
              activeStep={1}
              idPrefix="lab-narrow-seq"
            />
          </div>
          <div data-diagram class="flex flex-col gap-5">
            <ScreenFrame caption={pipelineFixture.caption} signal>
              <PipelineDiagram diagram={pipelineFixture} activeStep={3} />
            </ScreenFrame>
            <DiagramSteps
              steps={pipelineFixture.steps}
              nodes={pipelineFixture.nodes}
              activeStep={3}
              idPrefix="lab-narrow-pipe"
            />
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Decision log (all three kinds)</h3>
        <DecisionLog items={decisionsFixture} />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Showcase strip (a row that scrolls inside itself, with snap)</h3>
        <ShowcaseStrip screens={showcase.screens} />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Code block (always dark; a long line scrolls inside)</h3>
        <CodeBlock code={structureFixture.tree} label="Sample folder tree" />
        <CodeBlock
          code="a line that is much longer than the screen so the block has to scroll sideways inside itself instead of widening the page"
          label="Sample long line"
        />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Tool list</h3>
        <ToolList items={toolsFixture.groups[0]!.items} />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Fold (closed; open it to see the hide label)</h3>
        <Fold noun="tools">
          <ToolList items={toolsFixture.groups[0]!.items} />
        </Fold>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Contact links (the first is primary)</h3>
        <ContactLinks />
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-h3">Rule list</h3>
        <RuleList items={rulesFixture.items} />
      </div>
    </section>

    <section class="flex flex-col gap-section" aria-labelledby="lab-sections">
      <h2 id="lab-sections" class="text-h2">
        Project sections
      </h2>
      <p class="max-w-prose text-small text-muted">
        The sections as a project page composes them, with a sequence diagram. Filters on the list work.
      </p>
      <ProjectHeader project={sampleProject} />
      <ProjectOverview paragraphs={sampleProject.overview} />
      <ProjectArchitecture diagram={sequenceFixture} idPrefix="lab-seq" />
      <ProjectShowcase showcase={showcase} />
      <ProjectStructure structure={structureFixture} />
      <ProjectTools tools={toolsFixture} />
      <ProjectDecisions items={decisionsFixture} />
      <ProjectRules rules={rulesFixture} />
      <ProjectConnections projectTitle={sampleProject.title} outgoing={outgoing} incoming={incoming} />
      <ProjectList projects={fixtureProjects} />
    </section>
  </div>
</BaseLayout>

<style>
  /* Lab-only: a narrow column to show the phone drawings of the diagrams. */
  .lab-narrow {
    --lab-narrow-width: 22rem;
    max-width: var(--lab-narrow-width);
  }

  .ambient-stage {
    position: relative;
    height: 12rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--bg);
  }

  .ambient-glow {
    position: absolute;
    top: calc(var(--space-7) * -1);
    left: calc(var(--space-7) * -1);
    width: 18rem;
    height: 18rem;
    filter: blur(var(--space-5));
  }
</style>

<script>
  import { initLab } from "@/scripts/lab";

  initLab();
</script>
